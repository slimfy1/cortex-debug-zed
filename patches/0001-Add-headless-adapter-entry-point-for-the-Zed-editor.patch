diff --git a/src/backend/mi2/mi2.ts b/src/backend/mi2/mi2.ts
index e750f9a..689f2fc 100644
--- a/src/backend/mi2/mi2.ts
+++ b/src/backend/mi2/mi2.ts
@@ -264,6 +264,13 @@ export class MI2 extends EventEmitter implements IBackend {
     }
 
     private onOutputPartial(line) {
+        // A partial line made only of digits is the token prefix of an MI record
+        // (e.g. "5" of "5^done") that gdb flushed separately; wait for the rest of it.
+        // Newer gdb versions (seen with gdb 15) do this, and treating it as console
+        // output loses the token and hangs the session.
+        if (/^\d+$/.test(line)) {
+            return false;
+        }
         if (couldBeOutput(line)) {
             this.logNoNewLine('stdout', line);
             return true;
diff --git a/src/debugadapter-main.ts b/src/debugadapter-main.ts
