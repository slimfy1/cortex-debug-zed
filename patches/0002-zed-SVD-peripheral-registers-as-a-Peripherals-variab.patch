diff --git a/src/zed/peripherals.ts b/src/zed/peripherals.ts
new file mode 100644
index 0000000..9816041
--- /dev/null
+++ b/src/zed/peripherals.ts
@@ -0,0 +1,363 @@
+/*
+ * "Peripherals" scope for the Zed port: exposes SVD peripherals/registers/fields through the
+ * standard DAP scopes/variables/setVariable requests, so Zed's Variables panel acts as a
+ * peripheral register viewer. Values are read lazily (when a peripheral/cluster/register is
+ * expanded) and cached until the target runs again.
+ */
+
+import { DebugProtocol } from '@vscode/debugprotocol';
+import {
+    isReadable, isWritable, parseSvdNumber, SvdCluster, SvdDevice, SvdField, SvdNode, SvdPeripheral, SvdRegister
+} from './svd';
+
+/** Our slice of the variablesReference space. Must stay below 2^31 (DAP limit) and away from
+ *  cortex-debug's own handles, which count up from ~0x300000 and are reset on every stop. */
+export const PERIPH_REF_ROOT = 0x70000000;
+const PERIPH_REF_LIMIT = 0x7FFFFFFF;
+
+export interface MemoryAccess {
+    /** Returns the bytes as a hex string (like gdb's data-read-memory-bytes contents) */
+    read(address: number, length: number): Promise<string>;
+    write(address: number, hexBytes: string): Promise<void>;
+}
+
+type CacheEntry = bigint | Error;
+
+const B0 = BigInt(0);
+const B1 = BigInt(1);
+const B_FF = BigInt(0xFF);
+
+const NO_READ_WRITE_ONLY = '<write-only>';
+const NO_READ_SIDE_EFFECT = '<not read: read has side effects>';
+
+function hex(v: bigint, bits: number): string {
+    return '0x' + v.toString(16).toUpperCase().padStart(Math.max(1, Math.ceil(bits / 4)), '0');
+}
+
+function cType(bits: number): string {
+    switch (bits) {
+        case 8: return 'unsigned char';
+        case 16: return 'unsigned short';
+        case 64: return 'unsigned long long';
+        default: return 'unsigned int';
+    }
+}
+
+function accessTag(a: string): string {
+    switch (a) {
+        case 'read-only': return 'ro';
+        case 'write-only': return 'wo';
+        case 'writeOnce': return 'w1';
+        case 'read-writeOnce': return 'rw1';
+        default: return 'rw';
+    }
+}
+
+export class PeripheralProvider {
+    private cache = new Map<number, CacheEntry>();
+    private readonly gap: number;
+
+    constructor(public readonly device: SvdDevice, private mem: MemoryAccess, gapThreshold?: number) {
+        this.gap = (typeof gapThreshold === 'number' && gapThreshold >= 0) ? gapThreshold : 16;
+    }
+
+    public static isOurs(ref: number): boolean {
+        return ref >= PERIPH_REF_ROOT && ref <= PERIPH_REF_LIMIT;
+    }
+
+    public scope(): DebugProtocol.Scope {
+        return {
+            name: `Peripherals (${this.device.name})`,
+            variablesReference: PERIPH_REF_ROOT,
+            expensive: true,
+            presentationHint: 'registers'
+        };
+    }
+
+    /** Call whenever the target may have changed state (run, step, reset, memory write) */
+    public invalidate() {
+        this.cache.clear();
+    }
+
+    private ref(node: SvdNode): number {
+        return PERIPH_REF_ROOT + 1 + node.id;
+    }
+
+    private nodeOf(ref: number): SvdNode | undefined {
+        if (ref === PERIPH_REF_ROOT) {
+            return undefined;
+        }
+        return this.device.nodes[ref - PERIPH_REF_ROOT - 1];
+    }
+
+    // ------------------------------------------------------------------ reading
+
+    private async readRegisters(regs: SvdRegister[]): Promise<void> {
+        const todo = regs.filter((r) => isReadable(r) && !this.cache.has(r.id)).sort((a, b) => a.address - b.address);
+        if (todo.length === 0) {
+            return;
+        }
+        // Merge neighbouring registers into ranges so a peripheral takes a few memory reads, not dozens
+        const groups: SvdRegister[][] = [];
+        let cur: SvdRegister[] = [];
+        let end = 0;
+        for (const r of todo) {
+            const bytes = r.size / 8;
+            if (cur.length && (r.address - end <= this.gap) && (r.address + bytes - cur[0].address <= 1024)) {
+                cur.push(r);
+                end = Math.max(end, r.address + bytes);
+            } else {
+                if (cur.length) {
+                    groups.push(cur);
+                }
+                cur = [r];
+                end = r.address + bytes;
+            }
+        }
+        if (cur.length) {
+            groups.push(cur);
+        }
+
+        for (const g of groups) {
+            const start = g[0].address;
+            const stop = Math.max(...g.map((r) => r.address + r.size / 8));
+            try {
+                const data = await this.mem.read(start, stop - start);
+                for (const r of g) {
+                    this.cache.set(r.id, this.decode(data, r.address - start, r.size / 8));
+                }
+            } catch (e) {
+                // A gap inside the range may be unmapped; retry register by register
+                for (const r of g) {
+                    try {
+                        const data = await this.mem.read(r.address, r.size / 8);
+                        this.cache.set(r.id, this.decode(data, 0, r.size / 8));
+                    } catch (e2) {
+                        this.cache.set(r.id, e2 instanceof Error ? e2 : new Error(String(e2)));
+                    }
+                }
+            }
+        }
+    }
+
+    private decode(hexData: string, offset: number, bytes: number): bigint {
+        const slice = hexData.substr(offset * 2, bytes * 2);
+        if (slice.length < bytes * 2) {
+            throw new Error('short read');
+        }
+        const b: string[] = [];
+        for (let i = 0; i < bytes; i++) {
+            b.push(slice.substr(i * 2, 2));
+        }
+        if (this.device.littleEndian) {
+            b.reverse();
+        }
+        return BigInt('0x' + b.join(''));
+    }
+
+    private encode(value: bigint, bytes: number): string {
+        const b: string[] = [];
+        for (let i = 0; i < bytes; i++) {
+            b.push(Number((value >> BigInt(8 * i)) & B_FF).toString(16).padStart(2, '0'));
+        }
+        if (!this.device.littleEndian) {
+            b.reverse();
+        }
+        return b.join('');
+    }
+
+    private fieldValue(f: SvdField, regVal: bigint): bigint {
+        return (regVal >> BigInt(f.bitOffset)) & ((B1 << BigInt(f.bitWidth)) - B1);
+    }
+
+    // ------------------------------------------------------------------ presentation
+
+    private registerValue(r: SvdRegister): string {
+        if (r.access === 'write-only') {
+            return NO_READ_WRITE_ONLY;
+        }
+        if (r.readAction) {
+            return NO_READ_SIDE_EFFECT;
+        }
+        const v = this.cache.get(r.id);
+        if (v === undefined) {
+            return '…';
+        }
+        if (v instanceof Error) {
+            return `<error: ${v.message}>`;
+        }
+        return hex(v, r.size);
+    }
+
+    private fieldText(f: SvdField, v: bigint): string {
+        const raw = f.bitWidth === 1 ? v.toString() : `${hex(v, f.bitWidth)} (${v.toString()})`;
+        const en = f.enums.find((e) => e.value === v) || f.enums.find((e) => e.isDefault);
+        return en ? `${en.name} = ${raw}` : raw;
+    }
+
+    private childVar(c: SvdCluster | SvdRegister | SvdPeripheral): DebugProtocol.Variable {
+        if (c.kind === 'peripheral') {
+            return {
+                name: c.name,
+                value: hex(BigInt(c.baseAddress), 32) + (c.description ? `  ${c.description}` : ''),
+                type: c.groupName ? `peripheral (${c.groupName})` : 'peripheral',
+                variablesReference: this.ref(c),
+                presentationHint: { kind: 'class', attributes: ['readOnly'] }
+            };
+        }
+        if (c.kind === 'cluster') {
+            return {
+                name: c.name,
+                value: hex(BigInt(c.address), 32) + (c.description ? `  ${c.description}` : ''),
+                type: 'cluster',
+                variablesReference: this.ref(c),
+                presentationHint: { kind: 'class', attributes: ['readOnly'] }
+            };
+        }
+        const attrs: string[] = [];
+        if (!isWritable(c.access)) {
+            attrs.push('readOnly');
+        }
+        return {
+            name: c.name,
+            value: this.registerValue(c),
+            type: `${accessTag(c.access)} u${c.size} @ ${hex(BigInt(c.address), 32)}${c.description ? ' — ' + c.description : ''}`,
+            variablesReference: c.fields.length ? this.ref(c) : 0,
+            evaluateName: `*(volatile ${cType(c.size)} *)${hex(BigInt(c.address), 32)}`,
+            memoryReference: hex(BigInt(c.address), 32),
+            presentationHint: { kind: 'property', attributes: attrs }
+        };
+    }
+
+    private fieldVar(f: SvdField, regVal: CacheEntry | undefined): DebugProtocol.Variable {
+        let value: string;
+        if (f.parent.access === 'write-only' || f.access === 'write-only') {
+            value = NO_READ_WRITE_ONLY;
+        } else if (f.parent.readAction) {
+            value = NO_READ_SIDE_EFFECT;
+        } else if (regVal === undefined) {
+            value = '…';
+        } else if (regVal instanceof Error) {
+            value = `<error: ${regVal.message}>`;
+        } else {
+            value = this.fieldText(f, this.fieldValue(f, regVal));
+        }
+        const hi = f.bitOffset + f.bitWidth - 1;
+        const bits = f.bitWidth === 1 ? `[${f.bitOffset}]` : `[${hi}:${f.bitOffset}]`;
+        const enumList = f.enums.filter((e) => e.value !== undefined).map((e) => `${e.name}=${e.value}`).join(', ');
+        return {
+            name: f.name,
+            value,
+            type: `${accessTag(f.access)} ${bits}${f.description ? ' — ' + f.description : ''}${enumList ? ' {' + enumList + '}' : ''}`,
+            variablesReference: 0,
+            presentationHint: { kind: 'property', attributes: isWritable(f.access) && isWritable(f.parent.access) ? [] : ['readOnly'] }
+        };
+    }
+
+    public async variables(ref: number): Promise<DebugProtocol.Variable[]> {
+        if (ref === PERIPH_REF_ROOT) {
+            return this.device.peripherals.map((p) => this.childVar(p));
+        }
+        const node = this.nodeOf(ref);
+        if (!node) {
+            return [];
+        }
+        if (node.kind === 'peripheral' || node.kind === 'cluster') {
+            await this.readRegisters(node.children.filter((c): c is SvdRegister => c.kind === 'register'));
+            return node.children.map((c) => this.childVar(c));
+        }
+        if (node.kind === 'register') {
+            await this.readRegisters([node]);
+            const v = this.cache.get(node.id);
+            return node.fields.map((f) => this.fieldVar(f, v));
+        }
+        return [];
+    }
+
+    // ------------------------------------------------------------------ writing
+
+    private parseInput(input: string, width: number, field?: SvdField): bigint {
+        const s = input.trim();
+        let v: bigint | undefined;
+        if (field) {
+            const byName = field.enums.find((e) => e.name.toLowerCase() === s.toLowerCase() && e.value !== undefined);
+            if (byName) {
+                v = byName.value;
+            }
+        }
+        if (v === undefined) {
+            // Accept the "NAME = 0x2 (2)" text we display as well as plain numbers
+            const m = /=\s*(\S+)/.exec(s);
+            v = parseSvdNumber(m ? m[1] : s.split(/\s/)[0]);
+        }
+        if (v === undefined || v < B0) {
+            throw new Error(`cannot parse "${input}" (use hex 0x.., decimal, binary 0b.. or an enum name)`);
+        }
+        if (v >= (B1 << BigInt(width))) {
+            throw new Error(`value ${hex(v, width)} does not fit in ${width} bit(s)`);
+        }
+        return v;
+    }
+
+    public async setVariable(ref: number, name: string, value: string): Promise<DebugProtocol.SetVariableResponse['body']> {
+        const parent = this.nodeOf(ref);
+        if (!parent) {
+            throw new Error('peripherals cannot be assigned; expand one and edit a register or field');
+        }
+        let reg: SvdRegister;
+        let field: SvdField | undefined;
+        if (parent.kind === 'register') {
+            reg = parent;
+            field = parent.fields.find((f) => f.name === name);
+            if (!field) {
+                throw new Error(`no field ${name} in ${reg.name}`);
+            }
+        } else if (parent.kind === 'peripheral' || parent.kind === 'cluster') {
+            const r = parent.children.find((c) => c.name === name);
+            if (!r || r.kind !== 'register') {
+                throw new Error(`${name} is not a register`);
+            }
+            reg = r;
+        } else {
+            throw new Error('not writable');
+        }
+        if (!isWritable(reg.access) || (field && !isWritable(field.access))) {
+            throw new Error(`${field ? field.name : reg.name} is read-only`);
+        }
+
+        const bytes = reg.size / 8;
+        let newReg: bigint;
+        if (field) {
+            const fv = this.parseInput(value, field.bitWidth, field);
+            let cur: bigint;
+            if (isReadable(reg)) {
+                this.cache.delete(reg.id);
+                await this.readRegisters([reg]);
+                const c = this.cache.get(reg.id);
+                if (c === undefined || c instanceof Error) {
+                    throw new Error(`cannot read ${reg.name} for read-modify-write: ${c instanceof Error ? c.message : 'unknown'}`);
+                }
+                cur = c;
+            } else {
+                cur = reg.resetValue ?? B0;
+            }
+            const mask = ((B1 << BigInt(field.bitWidth)) - B1) << BigInt(field.bitOffset);
+            newReg = (cur & ~mask) | (fv << BigInt(field.bitOffset));
+        } else {
+            newReg = this.parseInput(value, reg.size);
+        }
+
+        await this.mem.write(reg.address, this.encode(newReg, bytes));
+        this.invalidate();
+
+        // Read back so the UI shows what the hardware actually holds
+        await this.readRegisters([reg]);
+        const back = this.cache.get(reg.id);
+        if (field) {
+            const v = this.fieldVar(field, back);
+            return { value: v.value, type: v.type, variablesReference: 0 };
+        }
+        const v = this.childVar(reg);
+        return { value: v.value, type: v.type, variablesReference: v.variablesReference };
+    }
+}
