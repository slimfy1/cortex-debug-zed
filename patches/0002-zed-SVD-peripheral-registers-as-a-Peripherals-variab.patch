+/*
+ * Minimal CMSIS-SVD model for the Zed port of Cortex-Debug.
+ *
+ * Parses a .svd file into a flat, indexed tree (peripheral -> cluster* -> register -> field)
+ * so that every node gets a stable numeric id that can be used as a DAP variablesReference.
+ *
+ * Supported: derivedFrom (peripherals, clusters, registers), dim arrays (dim/dimIncrement/dimIndex,
+ * "%s" and "[%s]" names), nested clusters, register property inheritance (size, access, resetValue),
+ * bitOffset/bitWidth, lsb/msb and bitRange field forms, enumeratedValues (incl. isDefault),
+ * readAction (registers with read side effects are never read automatically).
+ */
+
+import * as fs from 'fs';
+import { XMLParser } from 'fast-xml-parser';
+
+export type SvdAccess = 'read-only' | 'write-only' | 'read-write' | 'writeOnce' | 'read-writeOnce';
+
+export interface SvdEnumValue {
+    name: string;
+    description?: string;
+    value?: bigint;          // undefined when isDefault
+    isDefault?: boolean;
+}
+
+export interface SvdField {
+    kind: 'field';
+    id: number;
+    name: string;
+    description?: string;
+    bitOffset: number;
+    bitWidth: number;
+    access: SvdAccess;
+    enums: SvdEnumValue[];
+    parent: SvdRegister;
+}
+
+export interface SvdRegister {
+    kind: 'register';
+    id: number;
+    name: string;
+    description?: string;
+    address: number;         // absolute
+    size: number;            // bits
+    access: SvdAccess;
+    resetValue?: bigint;
+    readAction?: string;
+    fields: SvdField[];
+    peripheral: SvdPeripheral;
+}
+
+export interface SvdCluster {
+    kind: 'cluster';
+    id: number;
+    name: string;
+    description?: string;
+    address: number;         // absolute
+    children: (SvdCluster | SvdRegister)[];
+    peripheral: SvdPeripheral;
+}
+
+export interface SvdPeripheral {
+    kind: 'peripheral';
+    id: number;
+    name: string;
+    description?: string;
+    groupName?: string;
+    baseAddress: number;
+    children: (SvdCluster | SvdRegister)[];
+}
+
+export type SvdNode = SvdPeripheral | SvdCluster | SvdRegister | SvdField;
+
+export interface SvdDevice {
+    name: string;
+    littleEndian: boolean;
+    peripherals: SvdPeripheral[];
+    nodes: SvdNode[];            // nodes[id] === node
+}
+
+interface RegProps {
+    size: number;
+    access: SvdAccess;
+    resetValue?: bigint;
+}
+
+// ---------------------------------------------------------------------------
+
+export function parseSvdNumber(v: any): bigint | undefined {
+    if (v === undefined || v === null) {
+        return undefined;
+    }
+    let s = String(v).trim().toLowerCase();
+    if (!s) {
+        return undefined;
+    }
+    try {
+        if (s.startsWith('#')) {
+            s = s.substring(1).replace(/x/g, '0');       // binary, 'x' = don't care
+            return BigInt('0b' + s);
+        }
+        if (s.startsWith('0b')) {
+            return BigInt('0b' + s.substring(2).replace(/x/g, '0'));
+        }
+        if (s.startsWith('0x')) {
+            return BigInt(s);
+        }
+        if (/^[0-9]+$/.test(s)) {
+            return BigInt(s);
+        }
+    } catch {
+        // fall through
+    }
+    return undefined;
+}
+
+function num(v: any, def?: number): number | undefined {
+    const b = parseSvdNumber(v);
+    return b === undefined ? def : Number(b);
+}
+
+function text(v: any): string | undefined {
+    if (v === undefined || v === null) {
+        return undefined;
+    }
+    if (typeof v === 'object') {
+        v = v['#text'];
+        if (v === undefined) {
+            return undefined;
+        }
+    }
+    const s = String(v).replace(/\s+/g, ' ').trim();
+    return s || undefined;
+}
+
+function asArray<T>(v: T | T[] | undefined): T[] {
+    if (v === undefined || v === null) {
+        return [];
+    }
+    return Array.isArray(v) ? v : [v];
+}
+
+function normAccess(a: any, def: SvdAccess): SvdAccess {
+    const s = text(a);
+    switch (s) {
+        case 'read-only':
+        case 'write-only':
+        case 'read-write':
+        case 'writeOnce':
+        case 'read-writeOnce':
+            return s;
+        default:
+            return def;
+    }
+}
+
+function mergeProps(parent: RegProps, x: any): RegProps {
+    return {
+        size: num(x?.size, parent.size),
+        access: normAccess(x?.access, parent.access),
+        resetValue: parseSvdNumber(x?.resetValue) ?? parent.resetValue
+    };
+}
+
+/** Expands the dim specification of an element into [name, offset] pairs */
+function expandDim(x: any, baseName: string): { name: string; offset: number }[] {
+    const dim = num(x.dim);
+    if (!dim) {
+        return [{ name: baseName.replace(/\[%s\]|%s/g, ''), offset: 0 }];
+    }
+    const inc = num(x.dimIncrement, 0);
+    let indices: string[] = [];
+    const di = text(x.dimIndex);
+    if (di) {
+        const range = /^(\d+)\s*-\s*(\d+)$/.exec(di);
+        const letters = /^([A-Za-z])\s*-\s*([A-Za-z])$/.exec(di);
+        if (range) {
+            for (let i = parseInt(range[1]); i <= parseInt(range[2]); i++) {
+                indices.push(String(i));
+            }
+        } else if (letters) {
+            for (let c = letters[1].charCodeAt(0); c <= letters[2].charCodeAt(0); c++) {
+                indices.push(String.fromCharCode(c));
+            }
+        } else {
+            indices = di.split(',').map((s) => s.trim());
+        }
+    }
+    const out: { name: string; offset: number }[] = [];
+    for (let i = 0; i < dim; i++) {
+        const idx = indices[i] ?? String(i);
+        let name: string;
+        if (baseName.includes('[%s]')) {
+            name = baseName.replace('[%s]', `[${idx}]`);
+        } else if (baseName.includes('%s')) {
+            name = baseName.replace('%s', idx);
+        } else {
+            name = `${baseName}${idx}`;
+        }
+        out.push({ name, offset: i * inc });
+    }
+    return out;
+}
+
+// ---------------------------------------------------------------------------
+
+class Builder {
+    public nodes: SvdNode[] = [];
+
+    private add<T extends SvdNode>(n: Omit<T, 'id'>): T {
+        const node = n as T;
+        node.id = this.nodes.length;
+        this.nodes.push(node);
+        return node;
+    }
+
+    private parseFields(xreg: any, reg: SvdRegister) {
+        const xfields = asArray(xreg.fields?.field);
+        const byName = new Map<string, any>();
+        for (const xf of xfields) {
+            const n = text(xf.name);
+            if (n) {
+                byName.set(n, xf);
+            }
+        }
+        for (let xf of xfields) {
+            const derived = text(xf['@_derivedFrom']);
+            if (derived && byName.has(derived)) {
+                xf = Object.assign({}, byName.get(derived), xf);
+            }
+            const baseName = text(xf.name);
+            if (!baseName) {
+                continue;
+            }
+            let bitOffset: number | undefined;
+            let bitWidth: number | undefined;
+            if (xf.bitOffset !== undefined) {
+                bitOffset = num(xf.bitOffset);
+                bitWidth = num(xf.bitWidth, 1);
+            } else if (xf.lsb !== undefined) {
+                bitOffset = num(xf.lsb);
+                bitWidth = num(xf.msb) - bitOffset + 1;
+            } else if (xf.bitRange !== undefined) {
+                const m = /\[\s*(\d+)\s*:\s*(\d+)\s*\]/.exec(text(xf.bitRange) || '');
+                if (m) {
+                    bitOffset = parseInt(m[2]);
+                    bitWidth = parseInt(m[1]) - bitOffset + 1;
+                }
+            }
+            if (bitOffset === undefined || !bitWidth || bitWidth < 1) {
+                continue;
+            }
+            const enums: SvdEnumValue[] = [];
+            for (const ev of asArray(xf.enumeratedValues)) {
+                const usage = text((ev).usage);
+                if (usage === 'write') {
+                    continue;
+                }
+                for (const e of asArray((ev).enumeratedValue)) {
+                    const name = text((e).name);
+                    if (!name) {
+                        continue;
+                    }
+                    const isDefault = text((e).isDefault) === 'true';
+                    enums.push({ name, description: text((e).description), value: parseSvdNumber((e).value), isDefault });
+                }
+            }
+            for (const { name, offset } of expandDim(xf, baseName)) {
+                const field = this.add<SvdField>({
+                    kind: 'field', name, description: text(xf.description),
+                    bitOffset: bitOffset + offset, bitWidth, access: normAccess(xf.access, reg.access), enums, parent: reg
+                });
+                reg.fields.push(field);
+            }
+        }
+        reg.fields.sort((a, b) => b.bitOffset - a.bitOffset);
+    }
+
+    private parseRegister(xreg: any, base: number, props: RegProps, periph: SvdPeripheral, out: (SvdCluster | SvdRegister)[]) {
+        const baseName = text(xreg.name);
+        if (!baseName) {
+            return;
+        }
+        const p = mergeProps(props, xreg);
+        const off = num(xreg.addressOffset, 0);
+        for (const { name, offset } of expandDim(xreg, baseName)) {
+            const reg = this.add<SvdRegister>({
+                kind: 'register', name, description: text(xreg.description),
+                address: base + off + offset, size: p.size, access: p.access, resetValue: p.resetValue,
+                readAction: text(xreg.readAction), fields: [], peripheral: periph
+            });
+            this.parseFields(xreg, reg);
+            out.push(reg);
+        }
+    }
+
+    private parseChildren(xparent: any, base: number, props: RegProps, periph: SvdPeripheral, out: (SvdCluster | SvdRegister)[]) {
+        const regs = xparent?.registers ?? xparent;     // peripherals wrap in <registers>, clusters don't
+        if (!regs) {
+            return;
+        }
+        // Resolve derivedFrom among siblings by name
+        const siblings = new Map<string, any>();
+        for (const x of [...asArray(regs.register), ...asArray(regs.cluster)]) {
+            const n = text((x).name);
+            if (n) {
+                siblings.set(n, x);
+            }
+        }
+        const resolve = (x: any) => {
+            const d = text(x['@_derivedFrom']);
+            if (d && siblings.has(d)) {
+                return Object.assign({}, siblings.get(d), x);
+            }
+            return x;
+        };
+        for (const xc of asArray(regs.cluster)) {
+            const c = resolve(xc);
+            const baseName = text(c.name);
+            if (!baseName) {
+                continue;
+            }
+            const p = mergeProps(props, c);
+            const off = num(c.addressOffset, 0);
+            for (const { name, offset } of expandDim(c, baseName)) {
+                const cluster = this.add<SvdCluster>({
+                    kind: 'cluster', name, description: text(c.description),
+                    address: base + off + offset, children: [], peripheral: periph
+                });
+                this.parseChildren(c, cluster.address, p, periph, cluster.children);
+                out.push(cluster);
+            }
+        }
+        for (const xr of asArray(regs.register)) {
+            this.parseRegister(resolve(xr), base, props, periph, out);
+        }
+        out.sort((a, b) => a.address - b.address);
+    }
+
+    public build(xml: string): SvdDevice {
+        const parser = new XMLParser({
+            ignoreAttributes: false,
+            attributeNamePrefix: '@_',
+            parseTagValue: false,          // keep numbers as strings; we parse SVD number formats ourselves
+            trimValues: true,
+            isArray: (tag) => ['peripheral', 'register', 'cluster', 'field', 'enumeratedValue', 'enumeratedValues'].includes(tag)
+        });
+        const doc = parser.parse(xml);
+        const dev = doc.device;
+        if (!dev) {
+            throw new Error('not an SVD file (no <device> element)');
+        }
+        const devProps: RegProps = {
+            size: num(dev.size, 32),
+            access: normAccess(dev.access, 'read-write'),
+            resetValue: parseSvdNumber(dev.resetValue)
+        };
+        const xperiphs = asArray(dev.peripherals?.peripheral);
+        const byName = new Map<string, any>();
+        for (const xp of xperiphs) {
+            const n = text(xp.name);
+            if (n) {
+                byName.set(n, xp);
+            }
+        }
+        const peripherals: SvdPeripheral[] = [];
+        for (const xp0 of xperiphs) {
+            let xp = xp0;
+            const derived = text(xp['@_derivedFrom']);
+            if (derived && byName.has(derived)) {
+                const base = byName.get(derived);
+                xp = Object.assign({}, base, xp);
+                if (!xp0.registers) {
+                    xp.registers = base.registers;
+                }
+            }
+            const baseName = text(xp.name);
+            if (!baseName) {
+                continue;
+            }
+            const props = mergeProps(devProps, xp);
+            const baseAddress = num(xp.baseAddress, 0);
+            for (const { name, offset } of expandDim(xp, baseName)) {
+                const periph = this.add<SvdPeripheral>({
+                    kind: 'peripheral', name, description: text(xp.description), groupName: text(xp.groupName),
+                    baseAddress: baseAddress + offset, children: []
+                });
+                this.parseChildren(xp, periph.baseAddress, props, periph, periph.children);
+                peripherals.push(periph);
+            }
+        }
+        peripherals.sort((a, b) => a.name.localeCompare(b.name));
+        const endian = text(dev.cpu?.endian);
+        return { name: text(dev.name) || 'device', littleEndian: endian !== 'big', peripherals, nodes: this.nodes };
+    }
+}
+
+export function loadSvd(file: string): SvdDevice {
+    return new Builder().build(fs.readFileSync(file, 'utf8'));
+}
+
+export function parseSvd(xml: string): SvdDevice {
+    return new Builder().build(xml);
+}
+
+/** All registers below a peripheral or cluster, depth first */
+export function registersOf(node: SvdPeripheral | SvdCluster): SvdRegister[] {
+    const out: SvdRegister[] = [];
+    const walk = (children: (SvdCluster | SvdRegister)[]) => {
+        for (const c of children) {
+            if (c.kind === 'register') {
+                out.push(c);
+            } else {
+                walk(c.children);
+            }
+        }
+    };
+    walk(node.children);
+    return out;
+}
+
+export function isReadable(reg: SvdRegister): boolean {
+    return reg.access !== 'write-only' && !reg.readAction;
+}
+
+export function isWritable(access: SvdAccess): boolean {
+    return access !== 'read-only';
+}
