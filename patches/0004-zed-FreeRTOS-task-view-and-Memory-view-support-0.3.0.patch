new file mode 100644
index 0000000..9251aa2
--- /dev/null
+++ b/src/zed/rtos.ts
@@ -0,0 +1,321 @@
+/*
+ * RTOS task viewer for the Zed port (FreeRTOS).
+ *
+ * Walks the FreeRTOS kernel lists through ordinary GDB expressions (no Python in GDB needed)
+ * and presents the tasks as an "RTOS" scope in the Variables panel: state, priority, stack
+ * high-water mark, run-time share and the TCB/stack addresses (which open in Zed's Memory view).
+ * Requires the FreeRTOS kernel (tasks.c) to be compiled with debug info, as usual.
+ */
+
+import { DebugProtocol } from '@vscode/debugprotocol';
+import { hexAddr, parseAddress } from './memory';
+
+export const RTOS_REF_ROOT = 0x60000000;
+const RTOS_REF_LIMIT = 0x6FFFFFFF;
+
+export interface GdbAccess {
+    /** Result of `-data-evaluate-expression` (throws on error) */
+    evaluate(expr: string): Promise<string>;
+    /** Hex string of memory contents (throws on error) */
+    read(address: number, length: number): Promise<string>;
+}
+
+interface Task {
+    tcb: number;
+    name: string;
+    state: string;
+    priority?: number;
+    basePriority?: number;
+    tcbNumber?: number;
+    stackBase?: number;       // pxStack (lowest address on Cortex-M)
+    stackTop?: number;        // pxTopOfStack (saved SP; meaningless for the running task)
+    stackEnd?: number;        // pxEndOfStack (only with configRECORD_STACK_HIGH_ADDRESS)
+    stackFree?: number;       // bytes never touched (0xA5 fill), i.e. the high-water mark
+    runTime?: number;
+}
+
+interface Snapshot {
+    tasks: Task[];
+    totalRunTime?: number;
+    error?: string;
+}
+
+const STACK_FILL = 0xA5;
+const MAX_TASKS = 256;
+const MAX_STACK_SCAN = 64 * 1024;
+
+function parseIntLoose(v: string | undefined): number | undefined {
+    if (v === undefined) {
+        return undefined;
+    }
+    const m = /^\s*(?:\([^)]*\)\s*)?(-?(?:0x[0-9a-fA-F]+|\d+))/.exec(v);
+    return m ? Number(m[1]) : undefined;
+}
+
+/** Pulls `name = value` for a top-level-ish field out of gdb's struct print */
+function field(struct: string, name: string): string | undefined {
+    const re = new RegExp(`(?:^|[{,\\s])${name} = ((?:"(?:[^"\\\\]|\\\\.)*"(?:, '\\\\000' <repeats \\d+ times>)?)|[^,}\\n]+)`);
+    const m = re.exec(struct);
+    return m ? m[1].trim() : undefined;
+}
+
+function taskName(raw: string | undefined): string {
+    if (!raw) {
+        return '?';
+    }
+    const m = /^"((?:[^"\\]|\\.)*)"/.exec(raw);
+    if (m) {
+        return m[1].replace(/\\000.*$/, '') || '?';
+    }
+    return raw;
+}
+
+export class FreeRtosProvider {
+    private detected: boolean | undefined;
+    private snapshot: Snapshot | null = null;
+    private tcbType = 'TCB_t';
+
+    constructor(private gdb: GdbAccess) {}
+
+    public static isOurs(ref: number): boolean {
+        return ref >= RTOS_REF_ROOT && ref <= RTOS_REF_LIMIT;
+    }
+
+    public invalidate() {
+        this.snapshot = null;
+    }
+
+    /** true once FreeRTOS symbols are found in the program (checked once per session) */
+    public async detect(): Promise<boolean> {
+        if (this.detected !== undefined) {
+            return this.detected;
+        }
+        try {
+            await this.gdb.evaluate('&uxCurrentNumberOfTasks');
+            await this.gdb.evaluate('&pxReadyTasksLists');
+            try {
+                await this.gdb.evaluate('sizeof(TCB_t)');
+                this.tcbType = 'TCB_t';
+            } catch {
+                await this.gdb.evaluate('sizeof(tskTCB)');
+                this.tcbType = 'tskTCB';
+            }
+            this.detected = true;
+        } catch {
+            this.detected = false;
+        }
+        return this.detected;
+    }
+
+    public scope(): DebugProtocol.Scope {
+        return { name: 'RTOS (FreeRTOS)', variablesReference: RTOS_REF_ROOT, expensive: true };
+    }
+
+    private async num(expr: string): Promise<number | undefined> {
+        try {
+            return parseIntLoose(await this.gdb.evaluate(expr));
+        } catch {
+            return undefined;
+        }
+    }
+
+    private async addr(expr: string): Promise<number | undefined> {
+        try {
+            return parseAddress(await this.gdb.evaluate(expr));
+        } catch {
+            return undefined;
+        }
+    }
+
+    private async walkList(listAddr: number, state: string, into: Map<number, string>) {
+        const L = `((List_t *)${hexAddr(listAddr)})`;
+        const count = await this.num(`${L}->uxNumberOfItems`);
+        if (!count) {
+            return;
+        }
+        let item = await this.addr(`${L}->xListEnd.pxNext`);
+        for (let i = 0; i < Math.min(count, MAX_TASKS) && item; i++) {
+            const owner = await this.addr(`((ListItem_t *)${hexAddr(item)})->pvOwner`);
+            if (owner && !into.has(owner)) {
+                into.set(owner, state);
+            }
+            item = await this.addr(`((ListItem_t *)${hexAddr(item)})->pxNext`);
+        }
+    }
+
+    private async stackFree(base: number, limit: number): Promise<number | undefined> {
+        let free = 0;
+        const max = Math.min(limit, MAX_STACK_SCAN);
+        while (free < max) {
+            const n = Math.min(256, max - free);
+            let hex: string;
+            try {
+                hex = await this.gdb.read(base + free, n);
+            } catch {
+                return free > 0 ? free : undefined;
+            }
+            const buf = Buffer.from(hex, 'hex');
+            for (let i = 0; i < buf.length; i++) {
+                if (buf[i] !== STACK_FILL) {
+                    return free + i;
+                }
+            }
+            free += buf.length;
+            if (buf.length < n) {
+                break;
+            }
+        }
+        return free;
+    }
+
+    private async takeSnapshot(): Promise<Snapshot> {
+        const states = new Map<number, string>();
+        const current = await this.addr('pxCurrentTCB');
+        const prios = await this.num('sizeof(pxReadyTasksLists)/sizeof(pxReadyTasksLists[0])') ?? 0;
+        const lists: [string, string][] = [];
+        for (let p = prios - 1; p >= 0; p--) {
+            lists.push([`&pxReadyTasksLists[${p}]`, 'Ready']);
+        }
+        lists.push(
+            ['&xPendingReadyList', 'Ready'],
+            ['pxDelayedTaskList', 'Blocked'],
+            ['pxOverflowDelayedTaskList', 'Blocked'],
+            ['&xSuspendedTaskList', 'Suspended'],      // also tasks blocked with portMAX_DELAY
+            ['&xTasksWaitingTermination', 'Deleted']
+        );
+        for (const [expr, state] of lists) {
+            const a = await this.addr(expr);
+            if (a) {
+                await this.walkList(a, state, states);
+            }
+        }
+        if (current) {
+            states.set(current, 'Running');
+        }
+
+        const tasks: Task[] = [];
+        for (const [tcb, state] of states) {
+            let s: string;
+            try {
+                s = await this.gdb.evaluate(`*(${this.tcbType} *)${hexAddr(tcb)}`);
+            } catch {
+                tasks.push({ tcb, name: '?', state });
+                continue;
+            }
+            const t: Task = {
+                tcb,
+                state,
+                name: taskName(field(s, 'pcTaskName')),
+                priority: parseIntLoose(field(s, 'uxPriority')),
+                basePriority: parseIntLoose(field(s, 'uxBasePriority')),
+                tcbNumber: parseIntLoose(field(s, 'uxTCBNumber')),
+                stackBase: parseAddress(field(s, 'pxStack')),
+                stackTop: parseAddress(field(s, 'pxTopOfStack')),
+                stackEnd: parseAddress(field(s, 'pxEndOfStack')),
+                runTime: parseIntLoose(field(s, 'ulRunTimeCounter'))
+            };
+            if (t.stackBase) {
+                const limit = t.stackEnd ? t.stackEnd + 4 - t.stackBase
+                    : (t.stackTop && t.stackTop > t.stackBase ? t.stackTop - t.stackBase : MAX_STACK_SCAN);
+                t.stackFree = await this.stackFree(t.stackBase, limit);
+            }
+            tasks.push(t);
+        }
+        tasks.sort((a, b) => (a.tcbNumber ?? 1e9) - (b.tcbNumber ?? 1e9) || (b.priority ?? 0) - (a.priority ?? 0));
+        const totalRunTime = tasks.some((t) => t.runTime !== undefined) ? await this.num('ulTotalRunTime') : undefined;
+        return { tasks, totalRunTime };
+    }
+
+    private async getSnapshot(): Promise<Snapshot> {
+        if (!this.snapshot) {
+            try {
+                this.snapshot = await this.takeSnapshot();
+            } catch (e) {
+                this.snapshot = { tasks: [], error: e instanceof Error ? e.message : String(e) };
+            }
+        }
+        return this.snapshot;
+    }
+
+    private summary(t: Task, snap: Snapshot): string {
+        const parts = [t.state];
+        if (t.priority !== undefined) {
+            parts.push(`prio ${t.priority}${t.basePriority !== undefined && t.basePriority !== t.priority ? ` (base ${t.basePriority})` : ''}`);
+        }
+        if (t.stackFree !== undefined) {
+            parts.push(`stack free ${t.stackFree} B`);
+        }
+        if (t.runTime !== undefined && snap.totalRunTime) {
+            parts.push(`cpu ${(100 * t.runTime / snap.totalRunTime).toFixed(1)}%`);
+        }
+        return parts.join(' · ');
+    }
+
+    public async variables(ref: number): Promise<DebugProtocol.Variable[]> {
+        const snap = await this.getSnapshot();
+        if (ref === RTOS_REF_ROOT) {
+            if (snap.error) {
+                return [{ name: 'error', value: snap.error, variablesReference: 0 }];
+            }
+            if (snap.tasks.length === 0) {
+                return [{ name: '(no tasks)', value: 'no tasks created yet or scheduler not started', variablesReference: 0 }];
+            }
+            const seen = new Map<string, number>();
+            return snap.tasks.map((t, i) => {
+                const n = (seen.get(t.name) ?? 0) + 1;
+                seen.set(t.name, n);
+                return {
+                    name: n > 1 ? `${t.name} (${n})` : t.name,
+                    value: this.summary(t, snap),
+                    type: `task @ ${hexAddr(t.tcb)}`,
+                    variablesReference: RTOS_REF_ROOT + 1 + i,
+                    memoryReference: hexAddr(t.tcb),
+                    presentationHint: { kind: 'class', attributes: ['readOnly'] }
+                };
+            });
+        }
+        const t = snap.tasks[ref - RTOS_REF_ROOT - 1];
+        if (!t) {
+            return [];
+        }
+        const v = (name: string, value: string, memoryReference?: number): DebugProtocol.Variable => ({
+            name, value, variablesReference: 0,
+            ...(memoryReference ? { memoryReference: hexAddr(memoryReference) } : {}),
+            presentationHint: { attributes: ['readOnly'] }
+        });
+        const out: DebugProtocol.Variable[] = [v('State', t.state)];
+        if (t.priority !== undefined) {
+            out.push(v('Priority', String(t.priority)));
+        }
+        if (t.basePriority !== undefined && t.basePriority !== t.priority) {
+            out.push(v('Base priority', `${t.basePriority} (inherited ${t.priority})`));
+        }
+        if (t.stackBase !== undefined) {
+            out.push(v('Stack start (pxStack)', hexAddr(t.stackBase), t.stackBase));
+        }
+        if (t.stackEnd !== undefined && t.stackBase !== undefined) {
+            out.push(v('Stack size', `${t.stackEnd + 4 - t.stackBase} B`));
+        }
+        if (t.stackTop !== undefined && t.state !== 'Running') {
+            out.push(v('Saved SP (pxTopOfStack)', hexAddr(t.stackTop), t.stackTop));
+            if (t.stackEnd !== undefined) {
+                out.push(v('Stack used now', `${t.stackEnd + 4 - t.stackTop} B`));
+            }
+        }
+        if (t.stackFree !== undefined) {
+            out.push(v('Stack free (high-water mark)', `${t.stackFree} B${t.stackFree === 0 ? '  ⚠ possible overflow' : ''}`));
+        }
+        if (t.runTime !== undefined) {
+            const pct = snap.totalRunTime ? `  (${(100 * t.runTime / snap.totalRunTime).toFixed(1)}%)` : '';
+            out.push(v('Run time', `${t.runTime}${pct}`));
+        }
+        if (t.tcbNumber !== undefined) {
+            out.push(v('TCB number', String(t.tcbNumber)));
+        }
+        out.push({
+            name: 'TCB', value: hexAddr(t.tcb), variablesReference: 0, memoryReference: hexAddr(t.tcb),
+            evaluateName: `*(${this.tcbType} *)${hexAddr(t.tcb)}`
+        });
+        return out;
+    }
+}
