+/*
+ * Helpers that make Zed's built-in Memory view work well against a microcontroller.
+ *
+ * Zed reads memory one 4 KiB page at a time and relies on DAP's `unreadableBytes` to map
+ * holes. GDB fails a whole `data-read-memory-bytes` if any byte is inaccessible, which on an
+ * MCU (flash / RAM / peripheral windows separated by reserved space) would blank entire pages.
+ * `readPartial` returns the readable prefix and the size of the unreadable run that follows,
+ * so Zed can issue the next request for the rest.
+ */
+
+export interface RawMemory {
+    /** Hex string of `length` bytes at `address`, or throws if any byte is unreadable */
+    read(address: number, length: number): Promise<string>;
+}
+
+export interface PartialRead {
+    data: Buffer;             // readable bytes starting at the requested address
+    unreadable: number;       // bytes after `data` known to be unreadable (0 = none / unknown)
+}
+
+const CHUNK = 256;
+const FINE = 16;
+const MIN = 4;
+
+function hexToBuf(h: string): Buffer {
+    return Buffer.from(h, 'hex');
+}
+
+async function tryRead(mem: RawMemory, address: number, length: number): Promise<Buffer | null> {
+    try {
+        const b = hexToBuf(await mem.read(address, length));
+        return b.length === length ? b : null;
+    } catch {
+        return null;
+    }
+}
+
+/** Longest readable prefix of [address, address+length), refining down to MIN bytes */
+async function readablePrefix(mem: RawMemory, address: number, length: number): Promise<Buffer> {
+    const parts: Buffer[] = [];
+    let pos = address;
+    const end = address + length;
+    for (const step of [CHUNK, FINE, MIN]) {
+        while (pos < end) {
+            const n = Math.min(step, end - pos);
+            const b = await tryRead(mem, pos, n);
+            if (!b) {
+                break;          // refine this chunk with a smaller step
+            }
+            parts.push(b);
+            pos += n;
+        }
+        if (pos >= end) {
+            break;
+        }
+    }
+    return Buffer.concat(parts);
+}
+
+export async function readPartial(mem: RawMemory, address: number, count: number): Promise<PartialRead> {
+    if (count <= 0) {
+        return { data: Buffer.alloc(0), unreadable: 0 };
+    }
+    const whole = await tryRead(mem, address, count);
+    if (whole) {
+        return { data: whole, unreadable: 0 };
+    }
+    const data = await readablePrefix(mem, address, count);
+    // Skip over the hole: probe forward on CHUNK-aligned boundaries for the next readable byte
+    let pos = address + data.length;
+    const end = address + count;
+    let next = Math.min(end, (Math.floor(pos / CHUNK) + 1) * CHUNK);
+    // The first MIN-aligned bytes right after the prefix are unreadable by construction
+    while (next < end) {
+        if (await tryRead(mem, next, MIN)) {
+            break;
+        }
+        next = Math.min(end, next + CHUNK);
+    }
+    pos = Math.max(pos + MIN, next);
+    return { data, unreadable: Math.min(end, pos) - (address + data.length) };
+}
+
+/** Extracts the first hex address from a gdb value like "(int *) 0x20000010 <buf>" or "0x8000" */
+export function parseAddress(value: string | undefined): number | undefined {
+    if (!value) {
+        return undefined;
+    }
+    const m = /0x[0-9a-fA-F]+/.exec(value);
+    if (!m) {
+        const d = /^\s*(\d+)\s*$/.exec(value);
+        return d ? parseInt(d[1], 10) : undefined;
+    }
+    return parseInt(m[0], 16);
+}
+
+export function hexAddr(a: number): string {
+    return '0x' + a.toString(16).padStart(8, '0');
+}
